<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="LabBDTest">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>lab_bd_class.Veiculo</class>
        <class>lab_bd_class.Motorista</class>
        <class>lab_bd_class.Viagem</class>
        <class>lab_bd_class.Manutencao</class>
        <class>lab_bd_class.ManutencaoVeiculo</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/frota_test"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
